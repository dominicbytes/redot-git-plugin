#!/usr/bin/env python

import os

env = {}
Import("env")
Import("ssl")

env["target_path"] = os.path.join(env["target_path"], env["platform"])
os.makedirs(env["target_path"], exist_ok=True)

if env["platform"] == "macos":
    if env["macos_deployment_target"] != "default":
        env.Append(CCFLAGS=["-mmacosx-version-min=" +
                            env["macos_deployment_target"]])
        env.Append(LINKFLAGS=["-mmacosx-version-min=" +
                              env["macos_deployment_target"]])
elif env["platform"] == "windows":
    env.Append(LIBS=["advapi32", "winhttp", "rpcrt4", "crypt32",
                    "ole32", "user32", "wsock32", "ws2_32", "bcrypt"])

# Catch allocation/conversion failures before returning through libgit2's C API.
# Enable exceptions only for provider objects; retain the binding build flags.
env["CPPDEFINES"] = [define for define in env["CPPDEFINES"]
                     if not (isinstance(define, tuple) and define[0] == "_HAS_EXCEPTIONS")]
env["CXXFLAGS"] = [flag for flag in env["CXXFLAGS"] if flag != "-fno-exceptions"]
env.AppendUnique(CXXFLAGS=["/EHsc"] if env.get("is_msvc", False) else ["-fexceptions"])

env.Append(CPPPATH=[".", "src/"])

env.Append(CPPPATH=["#thirdparty/git2/libgit2/include/"])

lib_sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    target=os.path.join(env["target_path"],
                        "{}{}{}".format(env["target_name"], env["suffix"], env["SHLIBSUFFIX"])),
    source=lib_sources
)
env.Depends(library, ssl)
Default(library)
